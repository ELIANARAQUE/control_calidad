# Supabase (obligatorio): URL y SERVICE ROLE KEY de tu proyecto (Settings -> API en el
# dashboard de Supabase). Sin esto el backend no arranca.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# Cifrado de datos sensibles (numero de documento, correo). Generar una clave nueva con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

MAX_ESTACIONES_CONCURRENTES=10
ADMIN_USUARIO=admin
ADMIN_CLAVE=admin123
YOLO_MODEL_PATH=../models/yolov8n-pose.pt
YOLO_TARGET_FPS=3.0
YOLO_DEVICE=cuda:0
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
